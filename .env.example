# Successful transcript runs only; preserve transcripts, metadata, and logs.
# 0 disables a limit. If both are enabled, either limit triggers cleanup.
MEDIA_KEEP_LAST=20
MEDIA_MAX_AGE_DAYS=0

# Media understanding: resolve backend before selecting its default model.
# mlx: Apple Silicon local; paraformer: DashScope cloud; faster-whisper: local Windows/Linux (CPU/GPU).
ASR_BACKEND=mlx
# Optional override; omit to use the selected backend's default:
# mlx: mlx-community/whisper-large-v3-turbo
# paraformer: paraformer-v2, fun-asr, fun-asr-2025-08-25,
# fun-asr-2025-11-07, fun-asr-mtl, fun-asr-mtl-2025-08-25
# faster-whisper: small (default), medium, large-v3-turbo, or any
# Systran/faster-whisper-* repository / local model directory
# ASR_MODEL=
OCR_BACKEND=rapidocr
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
